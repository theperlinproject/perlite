include_guard(GLOBAL)

include(CPM)
include(PerlinApiPackage)
find_package(Threads REQUIRED)
find_package(OpenSSL REQUIRED)

if(NOT TARGET miniz)
    CPMAddPackage(NAME miniz GITHUB_REPOSITORY richgel999/miniz GIT_TAG 3.0.2)
endif()
set_target_properties(miniz PROPERTIES POSITION_INDEPENDENT_CODE ON)

if(TARGET perlin_wasmedge AND NOT PERLITE_WASM3)
    set(PERLITE_WASM_SOURCES ${PERLIN_API_HOST_WASMEDGE_SOURCES} ${PERLIN_API_HOST_CORE_SOURCES})
    set(PERLITE_WASM_LIB perlin_wasmedge)
else()
    if(NOT TARGET wasm3_core)
        CPMAddPackage(NAME wasm3 GITHUB_REPOSITORY wasm3/wasm3 GIT_TAG 28ecb9af6d2040e474a70f7cb7f43666740141fb DOWNLOAD_ONLY YES)
        file(GLOB WASM3_CORE_SOURCES "${wasm3_SOURCE_DIR}/source/*.c")
        list(FILTER WASM3_CORE_SOURCES EXCLUDE REGEX "m3_api_")
        add_library(wasm3_core STATIC ${WASM3_CORE_SOURCES})
        target_include_directories(wasm3_core PUBLIC "${wasm3_SOURCE_DIR}/source")
        target_compile_definitions(wasm3_core PRIVATE d_m3HasTracer=0)
        if(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
            target_compile_definitions(wasm3_core PRIVATE MAP_NORESERVE=0)
        endif()
        if(MSVC)
            target_compile_options(wasm3_core PRIVATE /w)
        else()
            target_compile_options(wasm3_core PRIVATE -w)
        endif()
        set_target_properties(wasm3_core PROPERTIES POSITION_INDEPENDENT_CODE ON C_STANDARD 11)
    endif()
    set(PERLITE_WASM_SOURCES ${PERLIN_API_HOST_WASM3_SOURCES} ${PERLIN_API_HOST_CORE_SOURCES})
    set(PERLITE_WASM_LIB wasm3_core)
endif()

if(PERLITE_NETHERNET)
    if(NOT TARGET datachannel AND NOT TARGET datachannel-static)
        set(NO_EXAMPLES ON CACHE BOOL "" FORCE)
        set(NO_TESTS ON CACHE BOOL "" FORCE)
        set(LIBSRTP_TEST_APPS OFF CACHE BOOL "" FORCE)
        set(ENABLE_WARNINGS_AS_ERRORS OFF CACHE BOOL "" FORCE)
        set(_perlite_shared "${BUILD_SHARED_LIBS}")
        set(_perlite_pic "${CMAKE_POSITION_INDEPENDENT_CODE}")
        set(BUILD_SHARED_LIBS ON)
        set(CMAKE_POSITION_INDEPENDENT_CODE ON)
        CPMAddPackage(NAME libdatachannel
            GITHUB_REPOSITORY paullouisageneau/libdatachannel
            GIT_TAG v0.23.2
            EXCLUDE_FROM_ALL YES
            OPTIONS "USE_GNUTLS OFF" "USE_NICE OFF" "NO_TESTS ON" "NO_EXAMPLES ON")
        set(BUILD_SHARED_LIBS "${_perlite_shared}")
        set(CMAKE_POSITION_INDEPENDENT_CODE "${_perlite_pic}")
    endif()
    if(TARGET datachannel-static)
        set(PERLITE_DATACHANNEL datachannel-static)
    else()
        set(PERLITE_DATACHANNEL datachannel)
    endif()
endif()

if(PERLITE_LEVELDB)
    if(NOT TARGET leveldb)
        set(LEVELDB_BUILD_TESTS OFF CACHE BOOL "" FORCE)
        set(LEVELDB_BUILD_BENCHMARKS OFF CACHE BOOL "" FORCE)
        set(LEVELDB_INSTALL OFF CACHE BOOL "" FORCE)
        set(LEVELDB_SNAPPY OFF CACHE BOOL "" FORCE)
        set(LEVELDB_ZSTD OFF CACHE BOOL "" FORCE)
        set(LEVELDB_TCMALLOC OFF CACHE BOOL "" FORCE)
        set(LEVELDB_ZLIB ON CACHE BOOL "" FORCE)
        if(NOT ZLIB_LIBRARY STREQUAL "perlite_zlib")
            find_package(ZLIB QUIET)
        endif()
        if(NOT ZLIB_FOUND)
            CPMAddPackage(NAME zlib GITHUB_REPOSITORY madler/zlib GIT_TAG v1.3.1 DOWNLOAD_ONLY YES)
            if(NOT EXISTS "${zlib_SOURCE_DIR}/zlib.h" OR NOT EXISTS "${zlib_SOURCE_DIR}/zconf.h")
                file(REMOVE_RECURSE "${zlib_SOURCE_DIR}")
                message(FATAL_ERROR "perlite: the zlib download in ${zlib_SOURCE_DIR} was incomplete and has been removed; configure again")
            endif()
            set(_perlite_zlib_sources adler32 compress crc32 deflate gzclose gzlib gzread gzwrite infback inffast inflate inftrees trees uncompr zutil)
            list(TRANSFORM _perlite_zlib_sources PREPEND "${zlib_SOURCE_DIR}/")
            list(TRANSFORM _perlite_zlib_sources APPEND ".c")
            add_library(perlite_zlib STATIC ${_perlite_zlib_sources})
            target_include_directories(perlite_zlib PUBLIC "${zlib_SOURCE_DIR}")
            set_target_properties(perlite_zlib PROPERTIES POSITION_INDEPENDENT_CODE ON)
            if(MSVC)
                target_compile_definitions(perlite_zlib PRIVATE _CRT_SECURE_NO_DEPRECATE _CRT_NONSTDC_NO_DEPRECATE)
                target_compile_options(perlite_zlib PRIVATE /w)
            else()
                target_compile_definitions(perlite_zlib PRIVATE HAVE_UNISTD_H)
                target_compile_options(perlite_zlib PRIVATE -w)
            endif()
            set(ZLIB_INCLUDE_DIR "${zlib_SOURCE_DIR}" CACHE PATH "" FORCE)
            set(ZLIB_LIBRARY perlite_zlib CACHE STRING "" FORCE)
            set(ZLIB_LIBRARY_RELEASE perlite_zlib CACHE STRING "" FORCE)
            set(ZLIB_LIBRARY_DEBUG perlite_zlib CACHE STRING "" FORCE)
            find_package(ZLIB REQUIRED)
        endif()
        set(_perlite_shared "${BUILD_SHARED_LIBS}")
        set(BUILD_SHARED_LIBS OFF)
        CPMAddPackage(NAME leveldb GITHUB_REPOSITORY pmmp/leveldb GIT_TAG aba9e148149bda96c5212905c67275a53e701b1c EXCLUDE_FROM_ALL YES)
        set(BUILD_SHARED_LIBS "${_perlite_shared}")
    endif()
    set_target_properties(leveldb PROPERTIES POSITION_INDEPENDENT_CODE ON COMPILE_OPTIONS "" INTERFACE_COMPILE_OPTIONS "")
endif()
